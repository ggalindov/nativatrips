;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="470" width="170" height="46" as="geometry"/></mxCell><mxCell id="box17" value="&lt;b&gt;Módulo D&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CBE2F5;strokeColor=#4E7DA6;fontColor=#0A2540;fontSize=11;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="470" width="170" height="46" as="geometry"/></mxCell><mxCell id="e18" value="evento de dominio (in-process)" style="html=1;strokeColor=#5B6673;strokeWidth=1.4;rounded=1;endArrow=block;endFill=1;fontSize=10;fontColor=#33404D;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="box16" target="box17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note19" value="&lt;b&gt;Nota.&lt;/b&gt; Reglas de estilo: fuente Helvetica, rejilla activada, un diagrama por archivo.&lt;br&gt;Título arriba a la izquierda (18 pt, negrita); subtítulo gris (11 pt).&lt;br&gt;Toda flecha lleva su propósito y, entre corchetes, el protocolo o mecanismo.&lt;br&gt;Exportado a PNG en alta resolución para el documento de grado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#C9A227;strokeWidth=2;fontColor=#5A4A0A;fontSize=11;align=left;valign=top;spacing=10;arcSize=6;" vertex="1" parent="1"><mxGeometry x="600" y="390" width="560" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>