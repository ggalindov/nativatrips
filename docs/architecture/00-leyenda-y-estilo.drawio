<mxfile host="app.diagrams.net"><diagram name="Leyenda" id="d20"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title1" value="NativaTrips: Leyenda de notación y paleta de color" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1200" height="30" as="geometry"/></mxCell><mxCell id="subtitle2" value="Mismo estilo, misma fuente y misma paleta en los 18 diagramas de arquitectura y comportamiento." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5B6673;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1200" height="22" as="geometry"/></mxCell><mxCell id="box3" value="&lt;b&gt;Persona / actor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Usuario humano del sistema.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="84" width="270" height="110" as="geometry"/></mxCell><mxCell id="box4" value="&lt;b&gt;Sistema NativaTrips&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Sistema en alcance del proyecto.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="84" width="270" height="110" as="geometry"/></mxCell><mxCell id="box5" value="&lt;b&gt;Contenedor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Unidad desplegable: API, SPA, BD.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4C86C6;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="84" width="270" height="110" as="geometry"/></mxCell><mxCell id="box6" value="&lt;b&gt;Componente / módulo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Pieza interna de un contenedor.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9CC5EC;strokeColor=#4E7DA6;fontColor=#0A2540;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="940" y="84" width="270" height="110" as="geometry"/></mxCell><mxCell id="box7" value="&lt;b&gt;Sistema externo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Fuera del control del equipo (PayU, Anthropic, SMTP).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9A9AA0;strokeColor=#63636A;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="270" height="110" as="geometry"/></mxCell><mxCell id="box8" value="&lt;b&gt;Modelo de dominio / agregado&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Entidad rica con reglas de negocio.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CBE2F5;strokeColor=#4E7DA6;fontColor=#0A2540;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="220" width="270" height="110" as="geometry"/></mxCell><mxCell id="box9" value="&lt;b&gt;Repositorio / persistencia&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Acceso a datos (Spring Data JPA).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6E2C4;strokeColor=#B07A2B;fontColor=#5A3E11;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="220" width="270" height="110" as="geometry"/></mxCell><mxCell id="box10" value="&lt;b&gt;Enumeración&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Conjunto cerrado de valores.&lt;/font&gt;" style=