<mxfile host="app.diagrams.net"><diagram name="C4-Contexto" id="d40"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title21" value="NativaTrips: Diagrama de contexto del sistema (C4 nivel 1)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1200" height="30" as="geometry"/></mxCell><mxCell id="subtitle22" value="Actores y sistemas externos que interactúan con NativaTrips." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5B6673;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1200" height="22" as="geometry"/></mxCell><mxCell id="box23" value="&lt;b&gt;Turista / Visitante&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Consulta senderos, reserva,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;paga y usa el asistente.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="260" height="100" as="geometry"/></mxCell><mxCell id="box24" value="&lt;b&gt;Personal Administrativo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Gestiona el catálogo, revisa&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;excepciones y capacidad.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="260" height="100" as="geometry"/></mxCell><mxCell id="box25" value="&lt;b&gt;Guía Turístico Certificado&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Consulta su agenda y&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;registra la asistencia.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="260" height="100" as="geometry"/></mxCell><mxCell id="box26" value="&lt;b&gt;Representante Legal / Gerencia&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Consulta el dashboard para&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;decidir sobre precios y cupos.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="260" height="100" as="geometry"/></mxCell><mxCell id="box27" value="&lt;b&gt;Autoridad Ambiental&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PNN Chingaza&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Define límites de capacidad&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;y recibe el reporte.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="260" height="100" as="geometry"/></mxCell><mxCell id="box28" value="&lt;b&gt;NativaTrips&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Sistema de información web]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Centraliza catálogo, reservas,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;capacidad de carga, pagos,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;asistente conversacional y&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;recomendación de experiencias.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=13;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="300" width="340" height="260" as="geometry"/></mxCell><mxCell id="box29" value="&lt;b&gt;PayU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Sistema externo]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Pasarela de pagos: procesa el&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;anticipo y confirma por webhook.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9A9AA0;strokeColor=#63636A;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1090" y="90" width="300" height="100" as="geometry"/></mxCell><mxCell id="box30" value="&lt;b&gt;API de Anthropic&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Sistema externo]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Modelo Claude Haiku 4.5 para&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;el asistente conversacional.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9A9AA0;strokeColor=#63636A;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1090" y="240" width="300" height="100" as="geometry"/></mxCell><mxCell id="box31" value="&lt;b&gt;Servidor de correo (SMTP)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Sistema externo]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Correos transaccionales:&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;confirmación, NPS, pre-tour.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9A9AA0;strokeColor=#63636A;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" par