<mxfile host="app.diagrams.net"><diagram name="Leyenda" id="d20"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title1" value="NativaTrips: Leyenda de notación y paleta de color" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1200" height="30" as="geometry"/></mxCell><mxCell id="subtitle2" value="Mismo estilo, misma fuente y misma paleta en los 18 diagramas de arquitectura y comportamiento." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5B6673;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1200" height="22" as="geometry"/></mxCell><mxCell id="box3" value="&lt;b&gt;Persona / actor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Usuario humano del sistema.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="84" width="270" height="110" as="geometry"/></mxCell><mxCell id="box4" value="&lt;b&gt;Sistema NativaTrips&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Sistema en alcance del proyecto.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="84" width="270" height="110" as="geometry"/></mxCell><mxCell id="box5" value="&lt;b&gt;Contenedor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Unidad desplegable: API, SPA, BD.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4C86C6;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="84" width="270" height="110" as="geometry"/></mxCell><mxCell id="box6" value="&lt;b&gt;Componente / módulo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Pieza interna de un contenedor.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9CC5EC;strokeColor=#4E7DA6;fontColor=#0A2540;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="940" y="84" width="270" height="110" as="geometry"/></mxCell><mxCell id="box7" value="&lt;b&gt;Sistema externo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Fuera del control del equipo (PayU, Anthropic, SMTP).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9A9AA0;strokeColor=#63636A;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="270" height="110" as="geometry"/></mxCell><mxCell id="box8" value="&lt;b&gt;Modelo de dominio / agregado&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Entidad rica con reglas de negocio.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CBE2F5;strokeColor=#4E7DA6;fontColor=#0A2540;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="220" width="270" height="110" as="geometry"/></mxCell><mxCell id="box9" value="&lt;b&gt;Repositorio / persistencia&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Acceso a datos (Spring Data JPA).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6E2C4;strokeColor=#B07A2B;fontColor=#5A3E11;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="220" width="270" height="110" as="geometry"/></mxCell><mxCell id="box10" value="&lt;b&gt;Enumeración&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Conjunto cerrado de valores.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7E0F3;strokeColor=#7B61A8;fontColor=#3E2F5B;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="940" y="220" width="270" height="110" as="geometry"/></mxCell><mxCell id="box11" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9CC5EC;strokeColor=#4E7DA6;fontColor=#0A2540;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="1160" height="150" as="geometry"/></mxCell><mxCell id="title12" value="Convención de flechas" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="60" y="378" width="400" height="30" as="geometry"/></mxCell><mxCell id="box13" value="&lt;b&gt;Módulo A&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CBE2F5;strokeColor=#4E7DA6;fontColor=#0A2540;fontSize=11;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="416" width="170" height="46" as="geometry"/></mxCell><mxCell id="box14" value="&lt;b&gt;Módulo B&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CBE2F5;strokeColor=#4E7DA6;fontColor=#0A2540;fontSize=11;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="416" width="170" height="46" as="geometry"/></mxCell><mxCell id="e15" value="llamada síncrona [protocolo]" style="html=1;strokeColor=#5B6673;strokeWidth=1.4;rounded=1;endArrow=block;endFill=1;fontSize=10;fontColor=#33404D;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="box13" target="box14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="box16" value="&lt;b&gt;Módulo C&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CBE2F5;strokeColor=#4E7DA6;fontColor=#0A2540;fontSize=11;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="470" width="170" height="46" as="geometry"/></mxCell><mxCell id="box17" value="&lt;b&gt;Módulo D&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CBE2F5;strokeColor=#4E7DA6;fontColor=#0A2540;fontSize=11;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="470" width="170" height="46" as="geometry"/></mxCell><mxCell id="e18" value="evento de dominio (in-process)" style="html=1;strokeColor=#5B6673;strokeWidth=1.4;rounded=1;endArrow=block;endFill=1;fontSize=10;fontColor=#33404D;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="box16" target="box17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note19" value="&lt;b&gt;Nota.&lt;/b&gt; Reglas de estilo: fuente Helvetica, rejilla activada, un diagrama por archivo.&lt;br&gt;Título arriba a la izquierda (18 pt, negrita); subtítulo gris (11 pt).&lt;br&gt;Toda flecha lleva su propósito y, entre corchetes, el protocolo o mecanismo.&lt;br&gt;Exportado a PNG en alta resolución para el documento de grado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#C9A227;strokeWidth=2;fontColor=#5A4A0A;fontSize=11;align=left;valign=top;spacing=10;arcSize=6;" vertex="1" parent="1"><mxGeometry x="600" y="390" width="560" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="C4-Contexto" id="d40"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title21" value="NativaTrips: Diagrama de contexto del sistema (C4 nivel 1)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1200" height="30" as="geometry"/></mxCell><mxCell id="subtitle22" value="Actores y sistemas externos que interactúan con NativaTrips." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5B6673;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1200" height="22" as="geometry"/></mxCell><mxCell id="box23" value="&lt;b&gt;Turista / Visitante&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Consulta senderos, reserva,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;paga y usa el asistente.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="260" height="100" as="geometry"/></mxCell><mxCell id="box24" value="&lt;b&gt;Personal Administrativo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Gestiona el catálogo, revisa&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;excepciones y capacidad.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="260" height="100" as="geometry"/></mxCell><mxCell id="box25" value="&lt;b&gt;Guía Turístico Certificado&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Consulta su agenda y&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;registra la asistencia.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="260" height="100" as="geometry"/></mxCell><mxCell id="box26" value="&lt;b&gt;Representante Legal / Gerencia&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Consulta el dashboard para&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;decidir sobre precios y cupos.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="260" height="100" as="geometry"/></mxCell><mxCell id="box27" value="&lt;b&gt;Autoridad Ambiental&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PNN Chingaza&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Define límites de capacidad&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;y recibe el reporte.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="260" height="100" as="geometry"/></mxCell><mxCell id="box28" value="&lt;b&gt;NativaTrips&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Sistema de información web]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Centraliza catálogo, reservas,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;capacidad de carga, pagos,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;asistente conversacional y&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;recomendación de experiencias.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=13;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="300" width="340" height="260" as="geometry"/></mxCell><mxCell id="box29" value="&lt;b&gt;PayU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Sistema externo]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Pasarela de pagos: procesa el&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;anticipo y confirma por webhook.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9A9AA0;strokeColor=#63636A;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1090" y="90" width="300" height="100" as="geometry"/></mxCell><mxCell id="box30" value="&lt;b&gt;API de Anthropic&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Sistema externo]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Modelo Claude Haiku 4.5 para&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;el asistente conversacional.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9A9AA0;strokeColor=#63636A;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1090" y="240" width="300" height="100" as="geometry"/></mxCell><mxCell id="box31" value="&lt;b&gt;Servidor de correo (SMTP)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Sistema externo]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Correos transaccionales:&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;confirmación, NPS, pre-tour.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9A9AA0;strokeColor=#63636A;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1090" y="390" width="300" height="100" as="geometry"/></mxCell><mxCell id="e32" value="consulta, reserva y paga [HTTPS]" style="html=1;strokeColor=#5B6673;strokeWidth=1.4;rounded=1;endArrow=block;endFill=1;fontSize=10;fontColor=#33404D;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="box23" target="box28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e33" value="administra catálogo y excepciones [HTTPS]" style="html=1;strokeColor=#5B6673;strokeWidth=1.4;rounded=1;endArrow=block;endFill=1;fontSize=10;fontColor=#33404D;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.38;entryDx=0;entryDy=0;" edge="1" parent="1" source="box24" target="box28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e34" value="agenda y asistencia [HTTPS]" style="html=1;strokeColor=#5B6673;strokeWidth=1.4;rounded=1;endArrow=block;endFill=1;fontSize=10;fontColor=#33404D;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.62;entryDx=0;entryDy=0;" edge="1" parent="1" source="box25" target="box28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e35" value="consulta el dashboard [HTTPS]" style="html=1;strokeColor=#5B6673;strokeWidth=1.4;rounded=1;endArrow=block;endFill=1;fontSize=10;fontColor=#33404D;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="box26" target="box28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e36" value="configura límites y recibe reporte [HTTPS]" style="html=1;strokeColor=#5B6673;strokeWidth=1.4;rounded=1;endArrow=block;endFill=1;fontSize=10;fontColor=#33404D;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.12;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="box27" target="box28"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="e37" value="inicia el pago [HTTPS]" style="html=1;strokeColor=#5B6673;strokeWidth=1.4;rounded=1;endArrow=block;endFill=1;fontSize=10;fontColor=#33404D;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="box28" target="box29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e38" value="usa function calling [HTTPS/JSON]" style="html=1;strokeColor=#5B6673;strokeWidth=1.4;rounded=1;endArrow=block;endFill=1;fontSize=10;fontColor=#33404D;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="box28" target="box30"><mxGeometry relative="1" as="geometry"><mxPoint x="25" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e39" value="envía correos [SMTP]" style="html=1;strokeColor=#5B6673;strokeWidth=1.4;rounded=1;endArrow=block;endFill=1;fontSize=10;fontColor=#33404D;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="box28" target="box31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="C4-Contenedores" id="d58"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title41" value="NativaTrips: Diagrama de contenedores (C4 nivel 2)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1200" height="30" as="geometry"/></mxCell><mxCell id="subtitle42" value="Un único artefacto desplegable (monolito modular) más la base de datos y las integraciones externas." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5B6673;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1200" height="22" as="geometry"/></mxCell><mxCell id="box43" value="&lt;b&gt;Turista / Visitante&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Navegador web.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="240" height="110" as="geometry"/></mxCell><mxCell id="box44" value="&lt;b&gt;Equipo de ECOPALACIO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Personal, guía, gerencia.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="240" height="110" as="geometry"/></mxCell><mxCell id="box45" value="&lt;b&gt;Portal web&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: React SPA]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Portal del turista y&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;panel administrativo.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4C86C6;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="300" width="260" height="110" as="geometry"/></mxCell><mxCell id="box46" value="&lt;b&gt;API REST&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: Spring Boot 4 · Java 21]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Monolito modular: usuarios, senderos,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;capacidad, reservas, pagos, asistente,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;recomendación, notificaciones, dashboard.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Seguridad JWT · eventos de dominio in-process.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4C86C6;strokeColor=#2E6295;fontColor=#FFFFFF;fontSize=12;align=middle;valign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="740" y="160" width="400" height="420" as="geometry"/></mxCell><mxCell id="box47" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: base de datos]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&