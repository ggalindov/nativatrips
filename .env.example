# Copia este archivo como .env y completa los valores. Nunca subas el .env al repositorio.

# Base de datos
DB_NAME=nativatrips
DB_USERNAME=nativatrips
DB_PASSWORD=

# JWT (minimo 32 caracteres)
APP_JWT_SECRET=
APP_JWT_EXPIRATION_MINUTES=60

# PayU WebCheckout (vacias = credenciales publicas del sandbox de PayU)
PAYU_API_KEY=
PAYU_MERCHANT_ID=
PAYU_ACCOUNT_ID=
PAYU_TEST_MODE=true
PAYU_CURRENCY=COP
PAYU_RESPONSE_URL=http://localhost:3000/pagos/respuesta
PAYU_CONFIRMATION_URL=http://localhost:8080/api/v1/pagos/confirmacion

# Asistente conversacional (sin clave el chat responde 503)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MAX_TOKENS=1024
