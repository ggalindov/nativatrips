# Copiar este archivo a ".env" (no se sube a git) y completar los valores reales.

# Base de datos
DB_NAME=nativatrips
DB_USERNAME=nativatrips
DB_PASSWORD=cambia-esta-clave

# JWT - generar un secreto aleatorio de al menos 256 bits, por ejemplo con:
#   openssl rand -base64 32
APP_JWT_SECRET=
APP_JWT_EXPIRATION_MINUTES=60
