# Copia este archivo como .env y completa los valores. Nunca subas el .env al repositorio.

# Base de datos
DB_NAME=nativatrips
DB_USERNAME=nativatrips
DB_PASSWORD=

# JWT (minimo 32 caracteres)
APP_JWT_SECRET=
APP_JWT_EXPIRATION_MINUTES=60

# Contrato OpenAPI en /v3/api-docs y Swagger UI en /swagger-ui.html (false en produccion)
SPRINGDOC_ENABLED=true

# Direccion publica del frontend, base de los enlaces que llegan por correo
APP_FRONTEND_URL=http://localhost:3000

# Correo saliente. Vacio MAIL_HOST = los correos solo se registran en el log.
# Produccion: Gmail con contrasena de aplicacion (MAIL_HOST=smtp.gmail.com, MAIL_PORT=587).
# Con Docker Compose, si MAIL_HOST queda vacio, el backend usa Mailpit (buzon en http://localhost:8025).
MAIL_HOST=
MAIL_PORT=587
MAIL_USUARIO=
MAIL_CLAVE=
MAIL_REMITENTE=Eco Palacio Chingaza <reservas@ecopalacio.co>
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# Bloqueo del inicio de sesion tras intentos fallidos seguidos
AUTH_INTENTOS_MAXIMOS=5
AUTH_MINUTOS_BLOQUEO=15

# Asistente conversacional (sin clave el chat responde 503)
ASISTENTE_MENSAJES_POR_HORA=20
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MAX_TOKENS=1024
